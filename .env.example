# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The services read these directly and have no fallback defaults for credentials — a missing
# value fails startup instead of quietly using something insecure.

# --- walletdb ---
WALLET_DB_NAME=walletdb
WALLET_DB_USER=wallet
WALLET_DB_PASSWORD=replace-with-a-local-password
# Host port -> 5432 in the container. Overridable because some Windows machines reserve chunks of
# the 5000s for Hyper-V, and binding one of those fails with a permissions error that says nothing
# about the real cause. See the troubleshooting section of the README.
WALLET_DB_PORT=5433
WALLET_DB_URL=jdbc:postgresql://localhost:5433/walletdb

# --- authdb ---
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=replace-with-a-local-password
AUTH_DB_PORT=5434
AUTH_DB_URL=jdbc:postgresql://localhost:5434/authdb

# --- transferdb ---
TRANSFER_DB_NAME=transferdb
TRANSFER_DB_USER=transfer
TRANSFER_DB_PASSWORD=replace-with-a-local-password
TRANSFER_DB_PORT=5435
TRANSFER_DB_URL=jdbc:postgresql://localhost:5435/transferdb

# --- service discovery (static; there is no registry) ---
#
# These are the values for running the services on your host. Under
# `docker compose --profile services up`, compose overrides them with container names.
WALLET_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8081
TRANSFER_SERVICE_URL=http://localhost:8083
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json

# --- service-to-service credential ---
#
# Required on wallet-service's /internal/** endpoints, and presented by auth-service and
# transfer-service when they call them. Without it, anything that reaches the services' network can
# post movements into the ledger.
#
# Generate a fresh one — never reuse the placeholder:
#   openssl rand -base64 32
#
# mTLS is the right production answer and is a planned future extension;
# this is deliberately the simple version, not a pretence at the complicated one.
SERVICE_CREDENTIAL=

# --- gateway ---
#
# Comma-separated browser origins allowed to call the API. Empty means none, which is correct
# until there is a browser client: a wildcard here would let any site a user visits call this API
# as them.
CORS_ALLOWED_ORIGINS=

# --- container images (only used by `docker compose --profile services`) ---
# Defaults match what `./mvnw spring-boot:build-image` produces locally. Point them at GHCR to run
# published images instead.
IMAGE_REGISTRY=digital-wallet
IMAGE_TAG=latest

# --- JWT signing keypair ---
#
# auth-service signs access tokens with the private key; every other service verifies with the
# public half fetched from its JWKS endpoint. Only auth-service ever sees the private key.
#
# Generate your own — never reuse a keypair from anywhere, including this file's example values:
#
# Written to a temporary directory and deleted afterwards, so a private key never lands in the
# working tree where a stray `git add` could pick it up.
#
#   KEYS=$(mktemp -d)
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out "$KEYS/priv.der"
#   openssl pkcs8 -topk8 -nocrypt -inform DER -in "$KEYS/priv.der" -outform DER -out "$KEYS/priv_pkcs8.der"
#   openssl rsa -in "$KEYS/priv.der" -inform DER -pubout -outform DER -out "$KEYS/pub.der"
#   base64 -w0 "$KEYS/priv_pkcs8.der"    # -> JWT_PRIVATE_KEY
#   base64 -w0 "$KEYS/pub.der"           # -> JWT_PUBLIC_KEY
#   rm -rf "$KEYS"
#
# The private key must be PKCS#8 (base64 starts "MIIEv..."), not PKCS#1 ("MIIEog..."), which is
# what `openssl genpkey -outform DER` produces on its own — hence the pkcs8 step above.
#
# PEM headers are optional; the parser strips them and all whitespace, so the raw base64 body on
# a single line is the easiest thing to put in an env var.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
